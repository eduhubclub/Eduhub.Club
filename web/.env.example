# Copy to web/.env. Local only — never commit.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional. Student Clever button stays visible and explains it is not connected until this is set
# and a custom OAuth provider named "clever" exists in Supabase.
# Microsoft 365 student sign-in uses Supabase Auth → Azure. No extra key here.
VITE_CLEVER_CLIENT_ID=

# Public site origin, no trailing slash. Canonical host is the apex domain.
VITE_SITE_URL=https://eduhub.club

# First deploy (after login works on localhost)
# 1. Create a Supabase project. Run supabase/migrations/20260912180000_auth_profiles.sql
#    in the SQL editor. Deploy functions:
#      supabase functions deploy classroom-login --no-verify-jwt
#      supabase functions deploy classroom-roster
# 2. Auth → URL configuration:
#      Site URL = https://eduhub.club
#      Redirect URLs = https://eduhub.club
#        https://eduhub.club/reset-password
#        http://localhost:5173
#        http://localhost:5173/reset-password
# 3. Auth → Google provider, and a custom OAuth provider named clever when you have Clever keys.
#    Google Cloud authorized JavaScript origin = https://eduhub.club (and http://localhost:5173).
#    Authorized redirect = https://<project-ref>.supabase.co/auth/v1/callback
# 4. In Vercel, import this repo, set Root Directory to web, and add the VITE_ variables.
#    HTTPS comes from Vercel. Do not buy GoDaddy hosting or a separate SSL certificate.
# 5. In GoDaddy DNS (leave nameservers at GoDaddy), add only the records Vercel shows:
#      www  CNAME  cname.vercel-dns.com
#      @    A      76.76.21.21
#    Pick one canonical host (www or apex) and redirect the other in Vercel.
#    Those A/CNAME values are Vercel's published defaults — use the records Vercel
#    shows for this project if they differ.
# Custom email (you@yourdomain) waits.
